{
  "name": "my-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:webkit": "playwright test --project=iphone"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.0"
  }
}
